# =============================================================
# Gooday — variáveis de ambiente
# Copie para .env e preencha. No Vercel, cadastre as mesmas chaves
# em Project Settings > Environment Variables.
# =============================================================

# ---------- Supabase (cliente / browser) ----------
# Prefixo VITE_ => embutido no bundle e VISÍVEL no navegador.
# Só coloque aqui o que pode ser público.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Supabase (servidor apenas) ----------
# NUNCA prefixe com VITE_. Usar só em Edge Function / rota de servidor.
# Pegue em: Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ---------- App ----------
VITE_APP_NAME=Gooday
VITE_APP_URL=http://localhost:5173
